# NovaRemote Backend Environment Configuration

# JWT Configuration
SECRET_KEY=generate_a_random_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Async SQLite for dev; PostgreSQL for production: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./novaremote.db

# Environment (development | staging | production)
ENVIRONMENT=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Security & Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
